# ═══════════════════════════════════════════════════════
# .env.example — SPAN Studio Configuration
# ═══════════════════════════════════════════════════════

# ── Database (Neon.tech PostgreSQL) ──
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# ── Resend (Email Notifications) ──
RESEND_API_KEY=re_your-resend-api-key
CONTACT_EMAIL=agastya071@gmail.com

# ── Cloudflare Turnstile (Bot Protection) ──
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAA...
TURNSTILE_SECRET_KEY=0x4AAA...

# ── Cloudinary (Media CDN) ──
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# ── Site Configuration ──
NEXT_PUBLIC_SITE_URL=https://spanstudio.in
NEXT_PUBLIC_WHATSAPP_NUMBER=917078382213
NEXT_PUBLIC_PHONE_NUMBER=+917078382213
NEXT_PUBLIC_GOOGLE_MAPS_URL=https://maps.app.goo.gl/your-shop-link-or-place-id

# ── Sentry (Error Tracking — optional for V1) ──
SENTRY_DSN=https://your-sentry-dsn
SENTRY_AUTH_TOKEN=your-sentry-auth-token
